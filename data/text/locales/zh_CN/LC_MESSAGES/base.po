#: src/quest_journal.py
msgid "Get the Rainbow Drop."
msgstr "取得彩虹之露。"

#: src/quest_journal.py
msgid "Thou hast heard of nothing yet."
msgstr "还什么都没听说。"

#: src/quest_journal.py
msgid "If thou wishest:"
msgstr "若有意愿:"

#: src/quest_journal.py
msgid "Rescue Princess Gwaelin."
msgstr "救出萝拉公主。"

#: src/quest_journal.py
msgid "She is held in the Swamp Cave, south of Kol, behind a locked door. A dragon guards her."
msgstr "她被关在麦拉南方沼地洞窟里上了锁的门后面，由龙看守着。"

#: src/quest_journal.py
msgid "Carry Princess Gwaelin back to King Lorik."
msgstr "把萝拉公主带回拉鲁斯十六世身边。"

#: src/quest_journal.py
msgid "King Lorik waits in Tantegel Castle."
msgstr "拉鲁斯十六世在拉达托姆城等着。"

#: src/quest_journal.py
msgid "Get a Magic Key."
msgstr "取得钥匙。"

#: src/quest_journal.py
msgid "Magic Keys are sold in Tantegel Castle, Rimuldar and Cantlin."
msgstr "拉达托姆城、利姆尔达镇和麦尔基德有卖钥匙。"

#: src/quest_journal.py
msgid "Find the Silver Harp."
msgstr "找到银之竖琴。"

#: src/quest_journal.py
msgid "It lies deep in Garin's Grave. The way down is behind a locked door in Garinham."
msgstr "它在加雷之墓的深处。通往墓室的路在加雷镇上了锁的门后面。"

#: src/quest_journal.py
msgid "Take the Silver Harp to the old man in the shrine."
msgstr "把银之竖琴交给祠堂里的老人。"

#: src/quest_journal.py
msgid "The shrine is north and west of Kol. He gives the Staff of Rain for the harp."
msgstr "祠堂在麦拉的西北方。老人会用雨云法杖交换竖琴。"

#: src/quest_journal.py
msgid "Find the Stones of Sunlight."
msgstr "找到太阳石。"

#: src/quest_journal.py
msgid "They are in the cellar of Tantegel Castle, behind a locked door."
msgstr "它在拉达托姆城地下室上了锁的门后面。"

#: src/quest_journal.py
msgid "Find Erdrick's Token."
msgstr "找到洛特之印。"

#: src/quest_journal.py
msgid "From Tantegel Castle travel 70 leagues to the south and 40 to the east, and search."
msgstr "从拉达托姆城往南走70步、往东走40步，然后调查脚下。"

#: src/quest_journal.py
msgid "Take the Stones of Sunlight, the Staff of Rain and Erdrick's Token to the old man in the shrine."
msgstr "把太阳石、雨云法杖和洛特之印交给祠堂里的老人。"

#: src/quest_journal.py
msgid "The shrine is far to the south of Rimuldar. He gives the Rainbow Drop."
msgstr "祠堂在利姆尔达镇的遥远南方。老人会给你彩虹之露。"

#: src/quest_journal.py
msgid "Use the Rainbow Drop to make a bridge to Charlock."
msgstr "用彩虹之露架起通往龙王城的桥。"

#: src/quest_journal.py
msgid "Hold it up at the water's edge east of Charlock, on the western shore of Rimuldar's land."
msgstr "在龙王城东边、利姆尔达镇所在大陆的西岸举起它。"

#: src/quest_journal.py
msgid "Find the hidden way down in Charlock."
msgstr "找到龙王城里隐藏的下行通道。"

#: src/quest_journal.py
msgid "Search behind the Dragonlord's throne."
msgstr "调查龙王王座的后面。"

#: src/quest_journal.py
msgid "Defeat the Dragonlord."
msgstr "打倒龙王。"

#: src/quest_journal.py
msgid "He waits in the deepest part of Charlock."
msgstr "龙王在龙王城的最深处等着。"

#: src/quest_journal.py
msgid "Return to King Lorik."
msgstr "回到拉鲁斯十六世身边。"

#: src/quest_journal.py
msgid "Tantegel Castle awaits thy return."
msgstr "拉达托姆城正等着你归来。"

#: src/quest_journal.py
msgid "Find Erdrick's Armor."
msgstr "找到洛特之铠。"

#: src/quest_journal.py
msgid "It is hidden in the ruins of Hauksness, far to the south. Beware its guardian."
msgstr "它藏在遥远南方的废墟多姆多拉。小心守护它的魔物。"

#: src/quest_journal.py
msgid "Find Erdrick's Sword."
msgstr "找到洛特之剑。"

#: src/quest_journal.py
msgid "It lies deep within Charlock."
msgstr "它在龙王城的深处。"

#: src/quest_journal.py
msgid "Defeat the Golem guarding Cantlin."
msgstr "打倒守护麦尔基德的巨像兵。"

#: src/quest_journal.py
msgid "Golem fears the music of the flute. The Fairy Flute is in Kol, four steps south of the bath."
msgstr "巨像兵害怕笛声。妖精之笛在麦拉温泉往南4步的地方。"

