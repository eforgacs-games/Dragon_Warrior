#: src/quest_journal.py
msgid "If thou wishest:"
msgstr "If thou wishest:"

#: src/quest_journal.py
msgid "Rescue Princess Gwaelin."
msgstr "Rescue Princess Gwaelin."

#: src/quest_journal.py
msgid "She is held in the Swamp Cave, south of Kol, behind a locked door. A dragon guards her."
msgstr "She is held in the cave in the marshes, south of Kol, behind a locked door. A dragon guards her."

#: src/quest_journal.py
msgid "Carry Princess Gwaelin back to King Lorik."
msgstr "Carry Princess Gwaelin back to the King."

#: src/quest_journal.py
msgid "King Lorik waits in Tantegel Castle."
msgstr "His Majesty the King waits in Tantegel Castle."

#: src/quest_journal.py
msgid "Get a Magic Key."
msgstr "Get a Magic Key."

#: src/quest_journal.py
msgid "Magic Keys are sold in Tantegel Castle, Rimuldar and Cantlin."
msgstr "Magic keys are sold in Tantegel Castle, Rimuldar and Cantlin."

#: src/quest_journal.py
msgid "Find the Silver Harp."
msgstr "Find the Lyre of Ire."

#: src/quest_journal.py
msgid "It lies deep in Garin's Grave. The way down is behind a locked door in Garinham."
msgstr "It lies deep in the grave of Galen. The way down is behind a locked door in Galenholm."

#: src/quest_journal.py
msgid "Take the Silver Harp to the old man in the shrine."
msgstr "Take the Lyre of Ire to the old man in the shrine."

#: src/quest_journal.py
msgid "The shrine is north and west of Kol. He gives the Staff of Rain for the harp."
msgstr "The shrine is north and west of Kol. He gives the Staff of Rain for the Lyre."

#: src/quest_journal.py
msgid "Find the Stones of Sunlight."
msgstr "Find the Sunstone."

#: src/quest_journal.py
msgid "They are in the cellar of Tantegel Castle, behind a locked door."
msgstr "It is in the dungeon of Tantegel Castle, behind a locked door."

#: src/quest_journal.py
msgid "Find Erdrick's Token."
msgstr "Find the Mark of Erdrick."

#: src/quest_journal.py
msgid "From Tantegel Castle travel 70 leagues to the south and 40 to the east, and search."
msgstr "From Tantegel Castle travel 70 paces to the south and 40 paces to the east, and search."

#: src/quest_journal.py
msgid "Take the Stones of Sunlight, the Staff of Rain and Erdrick's Token to the old man in the shrine."
msgstr "Take the Sunstone, the Staff of Rain and the Mark of Erdrick to the old man in the holy shrine."

#: src/quest_journal.py
msgid "The shrine is far to the south of Rimuldar. He gives the Rainbow Drop."
msgstr "The shrine is far to the south of Rimuldar. He gives the Rainbow Drop."

#: src/quest_journal.py
msgid "Use the Rainbow Drop to make a bridge to Charlock."
msgstr "Use the Rainbow Drop to make a bridge to the Dragonlord's Castle."

#: src/quest_journal.py
msgid "Hold it up at the water's edge east of Charlock, on the western shore of Rimuldar's land."
msgstr "Hold it up on the western shore of Rimuldar's land, facing the Dragonlord's Castle."

#: src/quest_journal.py
msgid "Find the hidden way down in Charlock."
msgstr "Find the hidden staircase in the Dragonlord's Castle."

#: src/quest_journal.py
msgid "Search behind the Dragonlord's throne."
msgstr "Search behind the Dragonlord's throne."

#: src/quest_journal.py
msgid "Defeat the Dragonlord."
msgstr "Defeat the Dragonlord."

#: src/quest_journal.py
msgid "He waits in the deepest part of Charlock."
msgstr "He waits in the deepest part of his castle."

#: src/quest_journal.py
msgid "Return to King Lorik."
msgstr "Return to the King."

#: src/quest_journal.py
msgid "Tantegel Castle awaits thy return."
msgstr "Tantegel Castle awaits thy return."

#: src/quest_journal.py
msgid "Find Erdrick's Armor."
msgstr "Find Erdrick's Armour."

#: src/quest_journal.py
msgid "It is hidden in the ruins of Hauksness, far to the south. Beware its guardian."
msgstr "It is hidden in the ruins of Damdara, far to the south. Beware its guardian."

#: src/quest_journal.py
msgid "Find Erdrick's Sword."
msgstr "Find Erdrick's Sword."

#: src/quest_journal.py
msgid "It lies deep within Charlock."
msgstr "It lies deep within the Dragonlord's Castle."

#: src/quest_journal.py
msgid "Defeat the Golem guarding Cantlin."
msgstr "Defeat the golem guarding Cantlin."

#: src/quest_journal.py
msgid "Golem fears the music of the flute. The Fairy Flute is in Kol, four steps south of the bath."
msgstr "The golem fears the music of the faerie flute. It is in Kol, four paces south of the baths."

