msgstr "Wait! Wait, I prithee!"

#: src/ending.py
msgid "And thus the tale comes to an end...."
msgstr "And thus the tale comes to an end...."

#. official: map.34.1.3
#: src/ending.py
msgid "I cannot,"
msgstr "My thanks, Majesty, but no,"

